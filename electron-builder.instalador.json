{
  "appId": "com.sistematecnicocaja.app",
  "productName": "FaroDesk Servidor",
  "executableName": "FaroDeskServidor",
  "compression": "maximum",
  "electronLanguages": [
    "es",
    "es-419",
    "en-US"
  ],
  "directories": {
    "output": "dist-instalador"
  },
  "files": [
    "package.json",
    "main-instalador.js",
    "main.js",
    "main-caja.js",
    "server-tickets-tray.js",
    "preload.js",
    "preload-caja.js",
    "renderer.js",
    "renderer-caja.js",
    "app-dialog.js",
    "date-format.js",
    "license-ui.js",
    "login.js",
    "tickets.js",
    "alertas.js",
    "configuracion.js",
    "historial-ticket.js",
    "devoluciones-caja.js",
    "listado-caja.js",
    "reporte-listado-caja.js",
    "index.html",
    "index-caja.html",
    "tickets.html",
    "alertas.html",
    "configuracion.html",
    "historial-ticket.html",
    "devoluciones-caja.html",
    "listado-caja.html",
    "reporte-listado-caja.html",
    "login.html",
    "styles.css",
    "assets/**/*",
    "abm/**/*",
    "admin-panel/**/*",
    "api/**/*",
    "auth/**/*",
    "config/**/*",
    "license/**/*",
    "pdf/**/*",
    "services/**/*",
    "server/**/*",
    "db/**/*",
    "node_modules/**/*",
    "!**/*.log",
    "!**/*.zip",
    "!**/*.blockmap",
    "!app.config.json",
    "!server.config.json",
    "!.env",
    "!.env.*",
    "!server.config.example.json",
    "!app.config.example.json",
    "!postgres.env.example"
  ],
  "extraResources": [
    {
      "from": "server/start-gateway.ps1",
      "to": "server/start-gateway.ps1"
    },
    {
      "from": "server/start-postgresql.ps1",
      "to": "server/start-postgresql.ps1"
    },
    {
      "from": "server/install-gateway-task.ps1",
      "to": "server/install-gateway-task.ps1"
    },
    {
      "from": "server/install-postgresql-task.ps1",
      "to": "server/install-postgresql-task.ps1"
    },
    {
      "from": "server/uninstall-gateway-task.ps1",
      "to": "server/uninstall-gateway-task.ps1"
    },
    {
      "from": "server/uninstall-postgresql-task.ps1",
      "to": "server/uninstall-postgresql-task.ps1"
    },
    {
      "from": "server/install-postgresql-unattended.ps1",
      "to": "server/install-postgresql-unattended.ps1"
    },
    {
      "from": "server/install-postgresql-worker.ps1",
      "to": "server/install-postgresql-worker.ps1"
    },
    {
      "from": "server/bootstrap-server.ps1",
      "to": "server/bootstrap-server.ps1"
    },
    {
      "from": "server/setup-database.cmd",
      "to": "server/setup-database.cmd"
    },
    {
      "from": "server/register-startup-tasks.cmd",
      "to": "server/register-startup-tasks.cmd"
    },
    {
      "from": "server/bootstrap-server.cmd",
      "to": "server/bootstrap-server.cmd"
    },
    {
      "from": "server/repair-server.cmd",
      "to": "server/repair-server.cmd"
    },
    {
      "from": "server/configure-postgresql-instance.ps1",
      "to": "server/configure-postgresql-instance.ps1"
    },
    {
      "from": "server/schema.sql",
      "to": "server/schema.sql"
    },
    {
      "from": "server/base-inicial.sql",
      "to": "server/base-inicial.sql"
    },
    {
      "from": "server.config.example.json",
      "to": "server.config.example.json"
    },
    {
      "from": "app.config.example.json",
      "to": "app.config.example.json"
    },
    {
      "from": "installer/postgresql/runtime",
      "to": "postgresql/runtime"
    },
    {
      "from": "installer/terminal",
      "to": "terminal"
    }
  ],
  "extraMetadata": {
    "main": "main-instalador.js"
  },
  "win": {
    "target": "nsis",
    "icon": "assets/icons/servidor.ico",
    "artifactName": "FaroDeskServidor-Setup-${version}.${ext}"
  },
  "nsis": {
    "oneClick": false,
    "perMachine": true,
    "allowToChangeInstallationDirectory": true,
    "include": "installer/server-installer.nsh",
    "shortcutName": "FaroDesk Servidor"
  }
}
