{
  "appId": "com.sistematecnicocaja.app",
  "productName": "Sistema Tecnico y Caja",
  "directories": {
    "output": "dist-instalador"
  },
  "files": [
    "**/*",
    "!dist/**",
    "!dist-caja/**",
    "!dist-instalador/**",
    "!pdfs/**",
    "!*.zip",
    "!*.log",
    "!app.config.json",
    "!server.config.json",
    "!.env",
    "!.env.*"
  ],
  "extraResources": [
    {
      "from": "server/start-gateway.ps1",
      "to": "server/start-gateway.ps1"
    },
    {
      "from": "server/install-gateway-task.ps1",
      "to": "server/install-gateway-task.ps1"
    },
    {
      "from": "server/uninstall-gateway-task.ps1",
      "to": "server/uninstall-gateway-task.ps1"
    },
    {
      "from": "server.config.example.json",
      "to": "server.config.example.json"
    },
    {
      "from": "app.config.example.json",
      "to": "app.config.example.json"
    }
  ],
  "extraMetadata": {
    "main": "main-instalador.js"
  },
  "win": {
    "target": "nsis",
    "artifactName": "SistemaTecnicoCaja-Setup-${version}.${ext}"
  },
  "nsis": {
    "oneClick": false,
    "perMachine": true,
    "allowToChangeInstallationDirectory": true,
    "include": "installer/installer-components.nsh",
    "shortcutName": "Sistema Tecnico y Caja"
  }
}
