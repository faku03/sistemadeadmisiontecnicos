{
  "name": "sistema-tickets",
  "version": "1.0.0",
  "description": "Sistema de gestión de tickets",
  "main": "main.js",
  "author": "TuNombre",
  "scripts": {
    "start": "electron .",
    "start:caja": "electron main-caja.js",
    "server:start": "node server/index.js",
    "server:migrate": "node server/migrate.js",
    "server:seed-licenses": "node server/seed-licenses.js",
    "smoke:api-postgres": "node scripts/smoke-api-postgres.js",
    "smoke:license-server": "node scripts/smoke-license-server.js",
    "smoke:license-admin": "node scripts/smoke-license-admin.js",
    "build": "electron-builder",
    "build:caja": "electron-builder --config electron-builder.caja.json",
    "build:instalador": "electron-builder --config electron-builder.instalador.json",
    "postinstall": "electron-builder install-app-deps"
  },
  "dependencies": {
    "pdfkit": "^0.17.2",
    "pg": "^8.20.0",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "electron": "^40.0.0",
    "electron-builder": "^26.7.0"
  },
  "build": {
    "appId": "com.sistemadetickets.app",
    "productName": "SistemaDeTickets",
    "directories": {
      "output": "dist"
    },
    "files": [
      "**/*"
    ],
    "win": {
      "target": "nsis",
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
