{
  "appId": "com.sistematecnicocaja.terminal",
  "productName": "SistemaTerminal",
  "directories": {
    "output": "dist-terminal-next"
  },
  "files": [
    "package.json",
    "main-instalador.js",
    "main.js",
    "main-caja.js",
    "preload.js",
    "preload-caja.js",
    "renderer.js",
    "renderer-caja.js",
    "app-dialog.js",
    "date-format.js",
    "license-ui.js",
    "tickets.js",
    "alertas.js",
    "configuracion.js",
    "historial-ticket.js",
    "devoluciones-caja.js",
    "listado-caja.js",
    "reporte-listado-caja.js",
    "index.html",
    "index-caja.html",
    "tickets.html",
    "alertas.html",
    "configuracion.html",
    "historial-ticket.html",
    "devoluciones-caja.html",
    "listado-caja.html",
    "reporte-listado-caja.html",
    "styles.css",
    "abm/**/*",
    "api/**/*",
    "config/**/*",
    "license/**/*",
    "pdf/**/*",
    "services/**/*",
    "db/**/*",
    "node_modules/**/*",
    "!**/*.log",
    "!**/*.zip",
    "!app.config.json",
    "!server.config.json",
    "!.env",
    "!.env.*",
    "!admin-panel/**",
    "!dist/**",
    "!dist-caja/**",
    "!dist-instalador/**",
    "!dist-terminal/**",
    "!dist-terminal-fresh/**",
    "!docs/**",
    "!installer/**",
    "!pdfs/**",
    "!pdf_presupuesto/**",
    "!scripts/**",
    "!server/**",
    "!build-servidor.log",
    "!gateway*.log",
    "!tmp-gateway-*.log",
    "!test-*.log",
    "!postgres.env.example",
    "!.gitignore",
    "!electron-builder*.json"
  ],
  "extraMetadata": {
    "main": "main-instalador.js"
  },
  "win": {
    "target": "nsis",
    "artifactName": "SistemaTerminal-Setup-${version}.${ext}"
  },
  "nsis": {
    "oneClick": false,
    "perMachine": true,
    "allowToChangeInstallationDirectory": true,
    "include": "installer/terminal-installer.nsh",
    "shortcutName": "Sistema Terminal"
  }
}
